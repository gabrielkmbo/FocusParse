# Model providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# HuggingFace (required for dataset streaming)
HF_TOKEN=

# Modal layout-v3 endpoint token. Required for FocusParse layout detection.
# HF_TOKEN is accepted by the client as a temporary fallback only.
LAYOUT_EXTRACTION_V3_MODAL_TOKEN=

# Optional: self-hosted vLLM / sglang endpoint for OSS models
VLLM_API_KEY=

# Optional: LlamaCloud (LlamaParse / LlamaExtract baseline row, Phase 5)
LLAMA_CLOUD_API_KEY=

# Optional: layout endpoint override. Default uses the Modal layout-v3 service:
# FOCUSPARSE_LAYOUT_ENDPOINT_URL=https://llamaindex--layout-v3-triton-layoutv3triton-serve.modal.run

# Tesseract binary path (required for OCR on crops)
TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Optional: pin the HF dataset revision once parser-bench stabilizes
# FOCUSPARSE_DATASET_REVISION=

# Per-role tier overrides (cheap | mid | frontier). Default set in .claude/settings.json.
# FOCUSPARSE_TIER_PLANNER=cheap
# FOCUSPARSE_TIER_ROUTER=cheap
# FOCUSPARSE_TIER_REASONER=frontier
# FOCUSPARSE_TIER_VERIFIER=mid
# FOCUSPARSE_TIER_SCHEMA_EXTRACTOR=gemini_schema_extractor
# Alternatives for extraction A/Bs:
#   gemini_schema_fast | gemini_schema_lite | gemini_schema_lite_preview
