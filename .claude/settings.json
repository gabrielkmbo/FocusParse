{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./*)",
      "Write(./src/**)",
      "Write(./tests/**)",
      "Write(./scripts/**)",
      "Write(./configs/**)",
      "Write(./plans/**)",
      "Write(./.claude/memory/**)",
      "Write(./results/**)",
      "Bash(uv *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git submodule *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "mcp__claude_ai_Hugging_Face__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./third_party/**)",
      "Write(./uv.lock)"
    ]
  },
  "env": {
    "FOCUSPARSE_TIER_PLANNER": "cheap",
    "FOCUSPARSE_TIER_ROUTER": "cheap",
    "FOCUSPARSE_TIER_REASONER": "frontier",
    "FOCUSPARSE_TIER_VERIFIER": "mid"
  },
  "statusLine": {
    "type": "command",
    "command": "uv run python -m focusparse.cli.focus status --short 2>/dev/null || echo 'focusparse: not synced'"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["slack", "huggingface", "filesystem"]
}
